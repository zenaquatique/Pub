  var bacActuel = BACS[2]; // 54L par défaut
  var solActuel = null;     // { produitId, hauteurCm, capProduitId, capHauteurCm, sacs, sacsCap, volumeL, volumeLCap }

  function formaterPrix(n) {
    return n.toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
  }
  function texteLignePrix(produit) {
    return (produit.prixApprox ? '≈ ' : '') + formaterPrix(produit.prix);
  }

  // ---------- Étape 1 : sélection du bac ----------
  function rendreBacs() {
    elBac.innerHTML = BACS.map(function (b) {
      return '<option value="' + b.id + '">' + b.nom + ' — ' + b.longueur + '×' + b.largeur + '×' + b.hauteur + ' cm — ' + texteLignePrix(b) + '</option>';
    }).join('');
    elBac.value = bacActuel.id;
  }
  function appliquerBac() {
    // Certaines cuves (25L notamment) sont plus hautes que larges (25×41cm) :
    // avec la seule max-width, leur hauteur affichée exploserait (aspect-ratio
    // appliqué à une largeur fixe). On plafonne donc aussi la hauteur visuelle
    // à HAUTEUR_MAX_PX en réduisant la largeur affichée quand le bac est en
    // "portrait", pour qu'il reste raisonnable à l'écran sans être écrasé
    // (le ratio réel est toujours respecté, juste la taille d'affichage change).
    var HAUTEUR_MAX_PX = 420;
    var ratioBac = bacActuel.longueur / bacActuel.hauteur;
    var largeurPourHauteurMax = HAUTEUR_MAX_PX * ratioBac;
    var largeurAffichageFinale = Math.min(bacActuel.largeurAffichage, largeurPourHauteurMax);
    elTank.style.setProperty('--zaq-tank-max', largeurAffichageFinale + 'px');
    elTank.style.setProperty('--zaq-tank-ratio', bacActuel.longueur + ' / ' + bacActuel.hauteur);
    // Le widget ne doit JAMAIS forcer la page/le thème à s'élargir : il reste
    // toujours à 100% de la largeur que la page lui donne. Le bac grandit donc
    // seulement dans la limite de la place réellement disponible (via sa propre
    // max-width ci-dessus), jamais en poussant le conteneur de la page.
    //
    // La taille des éléments posés (plantes, déco...) est mise à l'échelle de la
    // largeur RÉELLEMENT affichée du bac (mesurée après mise en page), pas de sa
    // taille "théorique" : sur une page étroite où le bac est contraint, les
    // éléments restent proportionnés à ce qui est vraiment visible.
    // Plancher relevé à 56px (au lieu de 34) : les petites cuves ont une
    // max-width plus étroite (560px pour le 25L contre 1020px pour le 375L),
    // donc la taille des objets — calculée à partir de cette largeur réelle —
    // se réduisait deux fois de suite (cuve plus petite ET objets plus
    // petits dedans), rendant les plantes minuscules dans les petits bacs.
    var largeurReelle = elTank.getBoundingClientRect().width || bacActuel.largeurAffichage;
    var tailleItem = Math.max(56, Math.min(84, Math.round(largeurReelle / 13)));
    document.documentElement.style.setProperty('--zaq-item-size', tailleItem + 'px');
    if (solActuel) {
      calculerEtAppliquerSol();
    } else {
      appliquerVisuelBac(0, null, 0, null);
    }
    rafraichirCapacite();
  }
  // Taille à l'écran d'un objet posé dans le bac. Pour les plantes (tailleCm
  // renseigné) : proportionnelle à la vraie hauteur adulte de la plante par
  // rapport à la vraie hauteur du bac (en cm), donc une plante haute paraît
  // grande, une mousse rase paraît petite, et ça change correctement entre
  // un 25L (25cm de haut) et un 375L (50cm de haut). Plafonnée à 70% de la
  // hauteur du bac à l'écran pour ne jamais dépasser visuellement le bac,
  // plancher à 28px pour rester cliquable. Sans tailleCm (déco/matériel) :
  // ancien calcul générique proportionnel à la largeur affichée du bac.
  function calculerTailleItemPx(produit) {
    var hautTankPx = elTank.clientHeight || elTank.getBoundingClientRect().height || 300;
    if (produit && produit.tailleCm) {
      var px = (produit.tailleCm / bacActuel.hauteur) * hautTankPx;
      return Math.max(28, Math.min(Math.round(hautTankPx * 0.7), Math.round(px)));
    }
    var largeurReelle = elTank.getBoundingClientRect().width || bacActuel.largeurAffichage;
    return Math.max(56, Math.min(84, Math.round(largeurReelle / 13)));
  }
  elBac.addEventListener('change', function () {
    bacActuel = BACS.filter(function (b) { return b.id === elBac.value; })[0];
    appliquerBac();
    // Les objets déjà posés doivent être redimensionnés : leur taille dépend
    // de la hauteur réelle du bac (voir calculerTailleItemPx), donc changer
    // de cuve doit redessiner le bac, pas seulement recalculer le sol.
    rafraichir();
  });
  elBacAcheter.addEventListener('change', function () {
    rendrePanier();
    sauvegarder();
  });

  // ---------- Étape 2 : sélection du sol ----------
  function rendreSol() {
    elSolProduit.innerHTML = '<option value="">— Aucun —</option>' + PRODUITS_SOL.map(function (s) {
      return '<option value="' + s.id + '">' + s.nom + ' — ' + texteLignePrix(s) + '</option>';
    }).join('');
    elSolRecouvrement.innerHTML = SABLES_RECOUVREMENT.map(function (s) {
      return '<option value="' + s.id + '">' + s.nom + ' — ' + texteLignePrix(s) + '</option>';
    }).join('');
  }
  function calculerSacs(produit, hauteurCm) {
    var volumeL = (bacActuel.longueur * bacActuel.largeur * hauteurCm / 1000) * 1.1; // +10% marge, cf. Projet 02
    var contenanceL = produit.contenanceL || (produit.contenanceKg / produit.densiteKgParL);
    var sacs = Math.ceil(volumeL / contenanceL);
    return { volumeL: volumeL, sacs: sacs };
  }
  // Eau + recouvrement + sol peints en UN SEUL dégradé CSS directement sur le
  // bac (.zaq-builder__tank), plutôt que sur des divs enfants séparés : le
  // bac est l'élément dont on est sûr qu'il s'affiche (son propre fond est
  // toujours visible), donc c'est lui qui porte tout le visuel désormais.
  var EAU_DEBUT = 'rgba(154, 214, 195, 0.55)';
  var EAU_FIN = 'rgba(94, 168, 152, 0.55)';
  function appliquerVisuelBac(hauteurSolPct, couleurSol, hauteurCapPct, couleurCap) {
    var pTop = Math.max(0, 100 - hauteurSolPct - hauteurCapPct);
    var gradient = 'linear-gradient(180deg, ' + EAU_DEBUT + ' 0%, ' + EAU_FIN + ' ' + pTop + '%';
    if (hauteurCapPct > 0) {
      var pMid = 100 - hauteurSolPct;
      gradient += ', ' + couleurCap + ' ' + pTop + '%, ' + couleurCap + ' ' + pMid + '%';
      gradient += ', ' + couleurSol + ' ' + pMid + '%, ' + couleurSol + ' 100%)';
    } else if (hauteurSolPct > 0) {
      gradient += ', ' + couleurSol + ' ' + pTop + '%, ' + couleurSol + ' 100%)';
    } else {
      gradient += ', ' + EAU_FIN + ' 100%)';
    }
    elTank.style.setProperty('background-image', gradient, 'important');
  }
  function calculerEtAppliquerSol() {
    var produitSol = PRODUITS_PAR_ID_SOL(solActuel.produitId);
    if (!produitSol) return;

    if (produitSol.type === 'nutritif') {
      if (!solActuel.capProduitId) solActuel.capProduitId = SABLES_RECOUVREMENT[0].id;
      if (!solActuel.capHauteurCm) solActuel.capHauteurCm = 3;
      var produitCap = PRODUITS_PAR_ID_SOL(solActuel.capProduitId);
      var hauteurSolCm = solActuel.hauteurCm;
      var hauteurCapCm = solActuel.capHauteurCm;
      var hauteurTotaleCm = hauteurSolCm + hauteurCapCm;
      var hauteurSolPct = Math.max(4, Math.min(35, (hauteurSolCm / bacActuel.hauteur) * 100));
      var hauteurCapPct = Math.max(4, Math.min(35, (hauteurCapCm / bacActuel.hauteur) * 100));

      appliquerVisuelBac(hauteurSolPct, produitSol.couleur, hauteurCapPct, produitCap.couleur);

      var calcSol = calculerSacs(produitSol, hauteurSolCm);
      var calcCap = calculerSacs(produitCap, hauteurCapCm);
      solActuel.sacs = calcSol.sacs;
      solActuel.volumeL = calcSol.volumeL;
      solActuel.sacsCap = calcCap.sacs;
      solActuel.volumeLCap = calcCap.volumeL;

      elSolInfo.textContent =
        'Sol nutritif (' + hauteurSolCm + ' cm) : ' + calcSol.volumeL.toLocaleString('fr-FR', { maximumFractionDigits: 1 }) + ' L → ' + calcSol.sacs + ' sac' + (calcSol.sacs > 1 ? 's' : '') +
        ' · Recouvrement (' + hauteurCapCm + ' cm) : ' + calcCap.volumeL.toLocaleString('fr-FR', { maximumFractionDigits: 1 }) + ' L → ' + calcCap.sacs + ' sac' + (calcCap.sacs > 1 ? 's' : '') +
        ' · Hauteur totale : ' + hauteurTotaleCm + ' cm. Les deux sont ajoutés au panier.';

      elRecouvrementLigne.hidden = false;
      elSolRecouvrement.value = solActuel.capProduitId;
      boutonsHauteurCap.forEach(function (b) {
        b.setAttribute('aria-pressed', parseInt(b.getAttribute('data-hauteur'), 10) === hauteurCapCm ? 'true' : 'false');
      });
    } else {
      solActuel.capProduitId = null;
      solActuel.sacsCap = 0;
      solActuel.volumeLCap = 0;

      var hauteurPct = Math.max(6, Math.min(40, (solActuel.hauteurCm / bacActuel.hauteur) * 100));
      appliquerVisuelBac(hauteurPct, produitSol.couleur, 0, null);

      var calc = calculerSacs(produitSol, solActuel.hauteurCm);
      solActuel.sacs = calc.sacs;
      solActuel.volumeL = calc.volumeL;
      elSolInfo.textContent = 'Volume nécessaire : ' + calc.volumeL.toLocaleString('fr-FR', { maximumFractionDigits: 1 }) + ' L → ' + calc.sacs + ' sac' + (calc.sacs > 1 ? 's' : '') + ' ajouté' + (calc.sacs > 1 ? 's' : '') + ' au panier.';

      elRecouvrementLigne.hidden = true;
    }
  }
  function PRODUITS_PAR_ID_SOL(id) {
    return PRODUITS_SOL.filter(function (s) { return s.id === id; })[0];
  }
  elSolProduit.addEventListener('change', function () {
    if (!elSolProduit.value) {
      solActuel = null;
      appliquerVisuelBac(0, null, 0, null);
      elSolInfo.textContent = '';
      elRecouvrementLigne.hidden = true;
      boutonsHauteurSol.forEach(function (b) { b.setAttribute('aria-pressed', 'false'); });
      boutonsHauteurCap.forEach(function (b) { b.setAttribute('aria-pressed', 'false'); });
    } else {
      var hauteurActuelle = (solActuel && solActuel.hauteurCm) || 5;
      var capHauteurActuelle = solActuel ? solActuel.capHauteurCm : null;
      var capProduitActuel = solActuel ? solActuel.capProduitId : null;
      solActuel = { produitId: elSolProduit.value, hauteurCm: hauteurActuelle, capProduitId: capProduitActuel, capHauteurCm: capHauteurActuelle };
      boutonsHauteurSol.forEach(function (b) {
        b.setAttribute('aria-pressed', parseInt(b.getAttribute('data-hauteur'), 10) === hauteurActuelle ? 'true' : 'false');
      });
      calculerEtAppliquerSol();
    }
    rendrePanier();
    sauvegarder();
  });
  elSolRecouvrement.addEventListener('change', function () {
    if (!solActuel) return;
    solActuel.capProduitId = elSolRecouvrement.value;
    calculerEtAppliquerSol();
    rendrePanier();
    sauvegarder();
  });
  elSolAcheter.addEventListener('change', function () {
    rendrePanier();
    sauvegarder();
  });
  boutonsHauteurSol.forEach(function (bouton) {
    bouton.addEventListener('click', function () {
      boutonsHauteurSol.forEach(function (b) { b.setAttribute('aria-pressed', 'false'); });
      bouton.setAttribute('aria-pressed', 'true');
      var hauteurCm = parseInt(bouton.getAttribute('data-hauteur'), 10);
      if (!elSolProduit.value) {
        elSolProduit.value = PRODUITS_SOL[0].id;
      }
      solActuel = {
        produitId: elSolProduit.value,
        hauteurCm: hauteurCm,
        capProduitId: solActuel ? solActuel.capProduitId : null,
        capHauteurCm: solActuel ? solActuel.capHauteurCm : null
      };
      calculerEtAppliquerSol();
      rendrePanier();
      sauvegarder();
    });
  });
  boutonsHauteurCap.forEach(function (bouton) {
    bouton.addEventListener('click', function () {
      if (!solActuel) return;
      solActuel.capHauteurCm = parseInt(bouton.getAttribute('data-hauteur'), 10);
      calculerEtAppliquerSol();
      rendrePanier();
      sauvegarder();
    });
  });

  // ---------- Rendu palette (colonnes rétractables) ----------
  function rendrePalette() {
    var html = '';
    CATEGORIES.forEach(function (cat) {
      html += '<details class="zaq-builder__categorie" data-cat="' + cat.id + '">';
      html += '<summary class="zaq-builder__categorie-titre">' + cat.nom + ' <span class="zaq-builder__categorie-compte">(' + cat.produits.length + ')</span></summary>';
      html += '<div class="zaq-builder__categorie-corps">';
      cat.produits.forEach(function (p) {
        html +=
          '<div class="zaq-builder__carte" data-produit-id="' + p.id + '">' +
            '<div class="zaq-builder__carte-visuel">' + rendreVisuel(p) + '</div>' +
            '<div class="zaq-builder__carte-texte">' +
              '<span class="zaq-builder__carte-nom">' + p.nom + '</span>' +
              '<span class="zaq-builder__carte-prix">' + texteLignePrix(p) + '</span>' +
            '</div>' +
          '</div>';
      });
      html += '</div></details>';
    });
    elPalette.innerHTML = html;

    elPalette.querySelectorAll('.zaq-builder__carte').forEach(function (carte) {
      carte.addEventListener('pointerdown', function (e) {
        var produit = PRODUITS_PAR_ID[carte.getAttribute('data-produit-id')];
        demarrerGlisser(produit, e, null);
      });
    });
  }

  // ---------- Rendu bac ----------
  function rendreTank() {
    racine.querySelectorAll('.zaq-builder__item').forEach(function (el) { el.remove(); });
    placedItems.forEach(function (item) {
      var produit = PRODUITS_PAR_ID[item.produitId];
      if (!produit) return;
      var el = document.createElement('div');
      el.className = 'zaq-builder__item';
      el.setAttribute('data-uid', item.uid);
      var taillePx = calculerTailleItemPx(produit);
      el.style.width = taillePx + 'px';
      el.style.height = taillePx + 'px';
      el.style.left = item.xPct + '%';
      el.style.top = item.yPct + '%';
      el.style.zIndex = item.zIndex;
      el.innerHTML = '<div class="zaq-builder__item-visuel">' + rendreVisuel(produit) + '</div><span class="zaq-builder__item-supprimer" title="Retirer">×</span>';
      el.querySelector('.zaq-builder__item-supprimer').addEventListener('pointerdown', function (e) {
        e.stopPropagation();
      });
      el.querySelector('.zaq-builder__item-supprimer').addEventListener('click', function (e) {
        e.stopPropagation();
        retirerItem(item.uid);
      });
      el.addEventListener('pointerdown', function (e) {
        demarrerGlisser(produit, e, item.uid);
      });
      elTank.appendChild(el);
    });
  }

  function rafraichirCapacite() {
    var n = placedItems.length;
    var max = bacActuel.capaciteIndicative;
    elCapacite.textContent = n + ' / ~' + max + ' éléments conseillés pour ce bac';
    elCapacite.classList.toggle('zaq-builder__capacite--plein', n > max);
  }

  // ---------- Rendu panier ----------
  function rendrePanier() {
    var groupes = {};
    placedItems.forEach(function (item) {
      groupes[item.produitId] = (groupes[item.produitId] || 0) + 1;
    });
    var idsPlaces = Object.keys(groupes);

    var html = '';
    var total = 0;

    if (elBacAcheter.checked) {
      total += bacActuel.prix;
      html += '<li><span>1× ' + bacActuel.nom + '</span><span>' + texteLignePrix(bacActuel) + '</span></li>';
    }

    if (solActuel && solActuel.sacs && elSolAcheter.checked) {
      var produitSol = PRODUITS_PAR_ID_SOL(solActuel.produitId);
      var ligneTotalSol = produitSol.prix * solActuel.sacs;
      total += ligneTotalSol;
      html += '<li><span>' + solActuel.sacs + '× ' + produitSol.nom + ' (' + solActuel.hauteurCm + ' cm)</span><span>' + formaterPrix(ligneTotalSol) + '</span></li>';

      if (solActuel.capProduitId && solActuel.sacsCap) {
        var produitCap = PRODUITS_PAR_ID_SOL(solActuel.capProduitId);
        var ligneTotalCap = produitCap.prix * solActuel.sacsCap;
        total += ligneTotalCap;
        html += '<li><span>' + solActuel.sacsCap + '× ' + produitCap.nom + ' (recouvrement, ' + solActuel.capHauteurCm + ' cm)</span><span>' + formaterPrix(ligneTotalCap) + '</span></li>';
      }
    }

    idsPlaces.forEach(function (id) {
      var produit = PRODUITS_PAR_ID[id];
      var qte = groupes[id];
      var ligneTotal = produit.prix * qte;
      total += ligneTotal;
      html += '<li><span>' + qte + '× ' + produit.nom + '</span><span>' + formaterPrix(ligneTotal) + '</span></li>';
    });

    if (!html) {
      elListe.innerHTML = '<li class="zaq-builder__liste-vide" id="zaq-liste-vide">Votre bac est vide pour l\'instant.</li>';
      elBoutonAjouter.disabled = true;
      elTotal.textContent = formaterPrix(0);
      return;
    }

    elListe.innerHTML = html;
    elTotal.textContent = formaterPrix(total);
    elBoutonAjouter.disabled = false;
  }

  function rafraichir() {
    rendreTank();
    rendrePanier();
    rafraichirCapacite();
    sauvegarder();
  }

  // ---------- Persistance (localStorage, par visiteur) ----------
  function sauvegarder() {
    try {
      var donnees = {
        bacId: bacActuel.id,
        bacAcheter: elBacAcheter.checked,
        solAcheter: elSolAcheter.checked,
        sol: solActuel,
        items: placedItems.map(function (i) {
          return { produitId: i.produitId, xPct: i.xPct, yPct: i.yPct };
        })
      };
      window.localStorage.setItem(CLE_STOCKAGE, JSON.stringify(donnees));
    } catch (err) { /* stockage indisponible : on continue sans sauvegarde */ }
  }
  function charger() {
    try {
      var brut = window.localStorage.getItem(CLE_STOCKAGE);
      if (!brut) return;
      var donnees = JSON.parse(brut);
      if (donnees.bacId) {
        var bacTrouve = BACS.filter(function (b) { return b.id === donnees.bacId; })[0];
        if (bacTrouve) bacActuel = bacTrouve;
      }
      if (typeof donnees.bacAcheter === 'boolean') {
        elBacAcheter.checked = donnees.bacAcheter;
      }
      if (typeof donnees.solAcheter === 'boolean') {
        elSolAcheter.checked = donnees.solAcheter;
      }
      if (donnees.sol && PRODUITS_PAR_ID_SOL(donnees.sol.produitId)) {
        solActuel = donnees.sol;
      }
      (donnees.items || []).forEach(function (d) {
        if (!PRODUITS_PAR_ID[d.produitId]) return;
        placedItems.push({ uid: prochainUid++, produitId: d.produitId, xPct: d.xPct, yPct: d.yPct, zIndex: zIndexCourant++ });
      });
    } catch (err) { /* données corrompues ou stockage indisponible : on repart à vide */ }
  }

  // ---------- Actions sur les items du bac ----------
  function ajouterItem(produit, xPct, yPct) {
    placedItems.push({ uid: prochainUid++, produitId: produit.id, xPct: xPct, yPct: yPct, zIndex: zIndexCourant++ });
    rafraichir();
  }
  function deplacerItem(uid, xPct, yPct) {
    var item = placedItems.filter(function (i) { return i.uid === uid; })[0];
    if (!item) return;
    item.xPct = xPct;
    item.yPct = yPct;
    item.zIndex = zIndexCourant++;
    rafraichir();
  }
  function retirerItem(uid) {
    placedItems = placedItems.filter(function (i) { return i.uid !== uid; });
    rafraichir();
  }

  // ---------- Glisser-déposer (pointer events, souris + tactile) ----------
  function positionnerFantome(el, x, y) {
    // La taille du fantôme suit --zaq-item-size (variable selon la taille du bac) :
    // on centre donc sur sa taille réelle plutôt qu'une moitié fixe.
    var demiTaille = el.offsetWidth / 2 || 25;
    el.style.left = (x - demiTaille) + 'px';
    el.style.top = (y - demiTaille) + 'px';
  }

  function demarrerGlisser(produit, evenement, uidExistant) {
    evenement.preventDefault();

    var elReel = null;
    if (uidExistant !== null) {
      elReel = elTank.querySelector('[data-uid="' + uidExistant + '"]');
      if (elReel) elReel.style.visibility = 'hidden';
    }

    var fantome = document.createElement('div');
    fantome.className = 'zaq-builder__fantome';
    fantome.innerHTML = rendreVisuel(produit);
    var tailleFantome = calculerTailleItemPx(produit);
    fantome.style.width = tailleFantome + 'px';
    fantome.style.height = tailleFantome + 'px';
    document.body.appendChild(fantome);
    positionnerFantome(fantome, evenement.clientX, evenement.clientY);

    function surDeplacement(e) {
      positionnerFantome(fantome, e.clientX, e.clientY);
    }

    function surRelachement(e) {
      document.removeEventListener('pointermove', surDeplacement);
      document.removeEventListener('pointerup', surRelachement);
      fantome.remove();
      if (elReel) elReel.style.visibility = '';

      var rectTank = elTank.getBoundingClientRect();
      var dansLeBac =
        e.clientX >= rectTank.left && e.clientX <= rectTank.right &&
        e.clientY >= rectTank.top && e.clientY <= rectTank.bottom;

      if (dansLeBac) {
        // "left/top: X%" sur un élément posé se calcule par rapport à la boîte de
        // padding du bac (donc SANS sa bordure de 8px), alors que getBoundingClientRect()
        // inclut la bordure : sans cette correction, le point posé dérive de quelques
        // px vers la droite/le bas selon l'endroit du bac où on lâche.
        var cs = getComputedStyle(elTank);
        var bordureG = parseFloat(cs.borderLeftWidth) || 0;
        var bordureH = parseFloat(cs.borderTopWidth) || 0;
        var xPct = ((e.clientX - rectTank.left - bordureG) / elTank.clientWidth) * 100;
        var yPct = ((e.clientY - rectTank.top - bordureH) / elTank.clientHeight) * 100;
        xPct = Math.max(3, Math.min(97, xPct));
        yPct = Math.max(6, Math.min(94, yPct));
        if (uidExistant !== null) {
          deplacerItem(uidExistant, xPct, yPct);
        } else {
          ajouterItem(produit, xPct, yPct);
        }
      } else if (uidExistant !== null) {
        retirerItem(uidExistant);
      }
    }

    document.addEventListener('pointermove', surDeplacement);
    document.addEventListener('pointerup', surRelachement);
  }

  // ---------- Ajouter tout au panier ----------
  function ajouterAuPanier() {
    var groupes = {};
    placedItems.forEach(function (item) {
      groupes[item.produitId] = (groupes[item.produitId] || 0) + 1;
    });
    var lignes = Object.keys(groupes).map(function (id) {
      return { produit: PRODUITS_PAR_ID[id], quantite: groupes[id] };
    });
    if (elBacAcheter.checked) {
      lignes.push({ produit: bacActuel, quantite: 1 });
    }
    if (solActuel && solActuel.sacs && elSolAcheter.checked) {
      lignes.push({ produit: PRODUITS_PAR_ID_SOL(solActuel.produitId), quantite: solActuel.sacs });
      if (solActuel.capProduitId && solActuel.sacsCap) {
        lignes.push({ produit: PRODUITS_PAR_ID_SOL(solActuel.capProduitId), quantite: solActuel.sacsCap });
      }
    }
    if (lignes.length === 0) return;

    if (MODE_SHOPIFY) {
      var items = lignes.map(function (l) {
        return { id: l.produit.variantId, quantity: l.quantite };
      });
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: items })
      })
        .then(function (r) { return r.json(); })
        .then(function () { window.location.href = '/cart'; })
        .catch(function () {
          elConfirmation.hidden = false;
          elConfirmation.textContent = 'Erreur lors de l\'ajout au panier. Merci de réessayer.';
        });
      return;
    }

    var resume = lignes.map(function (l) {
      return l.quantite + '× ' + l.produit.nom;
    }).join(', ');
    elConfirmation.hidden = false;
    elConfirmation.textContent = '(Simulation) Ajouté au panier : ' + resume;
  }

  elBoutonAjouter.addEventListener('click', ajouterAuPanier);
  elBoutonVider.addEventListener('click', function () {
    placedItems = [];
    elConfirmation.hidden = true;
    rafraichir();
  });

  rendreBacs();
  rendreSol();
  rendrePalette();
  charger();
  elBac.value = bacActuel.id;
  if (solActuel) {
    elSolProduit.value = solActuel.produitId;
    boutonsHauteurSol.forEach(function (b) {
      b.setAttribute('aria-pressed', parseInt(b.getAttribute('data-hauteur'), 10) === solActuel.hauteurCm ? 'true' : 'false');
    });
  }
  appliquerBac();
  rafraichir();
})();
</script>
