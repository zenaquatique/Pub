  //
  // Laissé en dur (pas de boucle Liquid) : ce ne sont que 3 produits fixes,
  // avec des champs spécifiques (contenanceL/contenanceKg, densité, couleur,
  // type) qui n'existent pas comme metafields standard. Remplacer les prix
  // par {{ }} si on veut les récupérer depuis Shopify plutôt qu'à la main.
  var PRODUITS_SOL = [
    { id: 'dennerle-substrate', nom: 'Dennerle Substrate 2.5L', prix: 9.99, prixApprox: false, variantId: null, contenanceL: 2.5, couleur: '#8a6a4a', type: 'nutritif' },
    { id: 'sable-fin-riviere', nom: 'Sable Fin Rivière 2-3mm SUPERFISH', prix: 6.99, prixApprox: false, variantId: null, contenanceKg: 4, densiteKgParL: 1.55, couleur: '#c9a876', type: 'sable' },
    { id: 'sable-fin-blanc-neige', nom: 'Sable Fin Blanc Neige SUPERFISH', prix: 10.99, prixApprox: false, variantId: null, contenanceKg: 4, densiteKgParL: 1.55, couleur: '#e8ddc8', type: 'sable' }
  ];
  var SABLES_RECOUVREMENT = PRODUITS_SOL.filter(function (s) { return s.type === 'sable'; });

  // Bacs : dimensions reelles fournies par Owen (zen-aquatique.fr)
  var BACS = [
    { id: '25L', nom: 'Cuve Nue 25L Aquael', prix: 25.99, prixApprox: false, variantId: null, longueur: 41, largeur: 25, hauteur: 25, largeurAffichage: 560, capaciteIndicative: 8 },
    { id: '45L', nom: 'Cuve Nue 45L Aquael', prix: 39.99, prixApprox: false, variantId: null, longueur: 50, largeur: 30, hauteur: 30, largeurAffichage: 640, capaciteIndicative: 12 },
    { id: '54L', nom: 'Cuve Nue 54L Aquael', prix: 49.99, prixApprox: false, variantId: null, longueur: 60, largeur: 30, hauteur: 30, largeurAffichage: 700, capaciteIndicative: 15 },
    { id: '112L', nom: 'Cuve Nue 112L Aquael', prix: 79.99, prixApprox: true, variantId: null, longueur: 80, largeur: 35, hauteur: 40, largeurAffichage: 820, capaciteIndicative: 22 },
    { id: '200L', nom: 'Cuve Nue 200L Aquael', prix: 119.99, prixApprox: true, variantId: null, longueur: 100, largeur: 40, hauteur: 50, largeurAffichage: 900, capaciteIndicative: 30 },
    { id: '240L', nom: 'Cuve Nue 240L Aquael', prix: 149.99, prixApprox: true, variantId: null, longueur: 120, largeur: 40, hauteur: 50, largeurAffichage: 960, capaciteIndicative: 35 },
    { id: '375L', nom: 'Cuve Nue 375L Aquael', prix: 219.99, prixApprox: true, variantId: null, longueur: 150, largeur: 50, hauteur: 50, largeurAffichage: 1020, capaciteIndicative: 45 }
  ];

  var PRODUITS_PAR_ID = {};
  var ICONE_PAR_PRODUIT = {};
  CATEGORIES.forEach(function (cat) {
    cat.produits.forEach(function (p) {
