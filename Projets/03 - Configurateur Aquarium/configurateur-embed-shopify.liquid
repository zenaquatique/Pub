<div class="zaq-builder" id="zaq-builder">
  <div class="zaq-builder__etape">
    <label class="zaq-builder__etape-label" for="zaq-bac">1. Votre bac</label>
    <select class="zaq-builder__select" id="zaq-bac"></select>
    <label class="zaq-builder__checkbox">
      <input type="checkbox" id="zaq-bac-acheter">
      J'ai besoin d'acheter cette cuve <span class="zaq-builder__checkbox-note">(décochez si vous en avez déjà une)</span>
    </label>
  </div>

  <div class="zaq-builder__etape">
    <p class="zaq-builder__etape-label">2. Votre sol</p>
    <div class="zaq-builder__sol-ligne">
      <select class="zaq-builder__select" id="zaq-sol-produit">
        <option value="">— Aucun —</option>
      </select>
      <div class="zaq-builder__hauteurs" role="group" aria-label="Hauteur de sol" id="zaq-hauteurs-sol">
        <button type="button" class="zaq-builder__hauteur" data-hauteur="3">3 cm</button>
        <button type="button" class="zaq-builder__hauteur" data-hauteur="5">5 cm</button>
      </div>
    </div>
    <label class="zaq-builder__checkbox">
      <input type="checkbox" id="zaq-sol-acheter" checked>
      J'ai besoin d'acheter ce sol <span class="zaq-builder__checkbox-note">(décochez si vous en avez déjà)</span>
    </label>
    <div class="zaq-builder__sol-ligne" id="zaq-recouvrement-ligne" hidden>
      <label class="zaq-builder__recouvrement-label" for="zaq-sol-recouvrement">Sable de recouvrement (obligatoire par-dessus un sol nutritif)</label>
      <select class="zaq-builder__select" id="zaq-sol-recouvrement"></select>
      <div class="zaq-builder__hauteurs" role="group" aria-label="Hauteur de recouvrement" id="zaq-hauteurs-cap">
        <button type="button" class="zaq-builder__hauteur" data-hauteur="3">3 cm</button>
        <button type="button" class="zaq-builder__hauteur" data-hauteur="5">5 cm</button>
      </div>
    </div>
    <p class="zaq-builder__sol-info" id="zaq-sol-info"></p>
  </div>

  <div class="zaq-builder__principal">
    <div class="zaq-builder__palette" id="zaq-palette"></div>

    <div class="zaq-builder__scene">
      <div class="zaq-builder__tank" id="zaq-tank">
        <div class="zaq-builder__eau"></div>
        <div class="zaq-builder__fond" id="zaq-fond"></div>
        <div class="zaq-builder__fond-cap" id="zaq-fond-cap"></div>
      </div>
      <p class="zaq-builder__astuce">Glissez un produit de la liste vers le bac. Glissez un élément déjà posé pour le déplacer, ou faites-le glisser hors du bac pour le retirer.</p>
      <p class="zaq-builder__capacite" id="zaq-capacite"></p>
    </div>

    <div class="zaq-builder__panier">
      <h4 class="zaq-builder__panier-titre">Votre sélection</h4>
      <ul class="zaq-builder__liste" id="zaq-liste-panier">
        <li class="zaq-builder__liste-vide" id="zaq-liste-vide">Votre bac est vide pour l'instant.</li>
      </ul>
      <p class="zaq-builder__total">Total : <strong id="zaq-total">0,00&nbsp;€</strong></p>
      <button type="button" class="zaq-builder__bouton" id="zaq-ajouter-panier" disabled>Ajouter tout au panier</button>
      <button type="button" class="zaq-builder__bouton-secondaire" id="zaq-vider">Vider le bac</button>
      <p class="zaq-builder__confirmation" id="zaq-confirmation" hidden></p>
    </div>
  </div>
</div>

<style>
  .zaq-builder {
    width: 100%;
    margin: 24px 0;
    padding: 20px;
    border: 2px solid #9dbaa9;
    border-radius: 14px;
    background: #f7faf8;
    font-family: inherit;
    color: #14201a;
    box-sizing: border-box;
    transition: max-width 0.25s ease;
  }
  .zaq-builder *,
  .zaq-builder *::before,
  .zaq-builder *::after { box-sizing: border-box; }

  /* ---- Étapes 1 & 2 (bac, sol) ---- */
  .zaq-builder__etape {
    margin-bottom: 16px;
    padding-bottom: 16px;
    border-bottom: 1px solid #d3e0d8;
  }
  .zaq-builder__etape-label {
    display: block;
    margin: 0 0 8px;
    font-size: 14px;
    font-weight: 800;
    color: #14201a;
  }
  .zaq-builder__select {
    width: 100%;
    max-width: 420px;
    padding: 10px 12px;
    border: 2px solid #6f8a7a;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 600;
    font-family: inherit;
    background: #fff;
    color: #14201a;
  }
  .zaq-builder__sol-ligne {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }
  .zaq-builder__hauteurs {
    display: flex;
    gap: 8px;
  }
  .zaq-builder__hauteur {
    padding: 9px 16px;
    font-size: 14px;
    font-weight: 700;
    border: 2px solid #2f6b48;
    border-radius: 999px;
    background: #fff;
    color: #235939;
    cursor: pointer;
  }
  .zaq-builder__hauteur[aria-pressed="true"] {
    background: #2f6b48;
    color: #fff;
  }
  .zaq-builder__checkbox {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 10px;
    font-size: 13px;
    font-weight: 700;
    color: #14201a;
    cursor: pointer;
  }
  .zaq-builder__checkbox input {
    width: 16px;
    height: 16px;
    accent-color: #2f6b48;
    cursor: pointer;
  }
  .zaq-builder__checkbox-note {
    font-weight: 500;
    color: #5b6b60;
  }
  .zaq-builder__sol-info {
    margin: 10px 0 0;
    font-size: 13px;
    font-weight: 600;
    color: #3d4a43;
  }
  .zaq-builder__recouvrement-label {
    font-size: 13px;
    font-weight: 700;
    color: #14201a;
  }
  #zaq-recouvrement-ligne {
    margin-top: 10px;
    padding: 10px;
    border-radius: 8px;
    background: #eaf4ee;
  }
  #zaq-recouvrement-ligne[hidden] {
    display: none;
  }

  /* ---- Layout principal (palette | scène | panier) ---- */
  .zaq-builder__principal {
    display: grid;
    grid-template-columns: 240px 1fr 280px;
    gap: 20px;
    align-items: start;
  }
  @media (max-width: 900px) {
    .zaq-builder__principal { grid-template-columns: 1fr; }
  }

  /* ---- Palette : colonnes rétractables par catégorie ---- */
  /* Conteneur bloc simple (pas flex) : un conteneur flex-column avec overflow-y:auto
     ne réduit pas toujours ses enfants correctement (les <details> refusent de
     rétrécir sous leur contenu), ce qui empêchait le défilement de s'activer et
     laissait le contenu déborder hors du cadre au lieu de défiler dedans. */
  .zaq-builder__palette {
    max-height: 640px;
    overflow-y: auto;
    padding-right: 4px;
  }
  .zaq-builder__categorie {
    border: 2px solid #c9d6cd;
    border-radius: 10px;
    background: #fff;
    overflow: hidden;
    margin-bottom: 8px;
  }
  .zaq-builder__categorie:last-child {
    margin-bottom: 0;
  }
  .zaq-builder__categorie-titre {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 10px 12px;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.02em;
    color: #14201a;
    cursor: pointer;
    list-style: none;
  }
  .zaq-builder__categorie-titre::-webkit-details-marker { display: none; }
  .zaq-builder__categorie-titre::after {
    content: '+';
    font-size: 16px;
    font-weight: 700;
    color: #2f6b48;
    transition: transform 0.15s ease;
  }
  .zaq-builder__categorie[open] > .zaq-builder__categorie-titre::after {
    transform: rotate(45deg);
  }
  .zaq-builder__categorie-compte {
    font-weight: 500;
    color: #5b6b60;
  }
  .zaq-builder__categorie-corps {
    padding: 0 8px 8px;
  }
  .zaq-builder__carte {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 8px;
    border: 2px solid #e1e9e4;
    border-radius: 9px;
    background: #fbfdfc;
    cursor: grab;
    touch-action: none;
    user-select: none;
    margin-top: 6px;
  }
  .zaq-builder__carte:active { cursor: grabbing; }
  .zaq-builder__carte-visuel {
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    overflow: hidden;
  }
  .zaq-builder__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 6px;
    display: block;
  }
  .zaq-builder__carte-texte {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .zaq-builder__carte-nom {
    font-size: 12.5px;
    font-weight: 700;
    color: #14201a;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .zaq-builder__carte-prix {
    font-size: 12px;
    font-weight: 600;
    color: #2f6b48;
  }

  /* ---- Scène / bac ---- */
  .zaq-builder__scene {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .zaq-builder__tank {
    position: relative;
    width: 100%;
    max-width: var(--zaq-tank-max, 720px);
    margin: 0 auto;
    aspect-ratio: var(--zaq-tank-ratio, 2 / 1);
    border: 8px solid #3a4a42;
    border-radius: 8px;
    overflow: hidden;
    background: #dff0e6;
    /* Pas de transition ici : la taille des objets posés (--zaq-item-size) est
       mesurée en JS juste après un changement de bac — une transition animée
       ferait lire une valeur intermédiaire au lieu de la taille finale. */
  }
  /* L'eau + le sol + le recouvrement sont peints en un seul dégradé CSS
     directement sur .zaq-builder__tank (voir appliquerVisuelBac en JS) :
     ces trois divs enfants ne servent plus qu'à garder la structure HTML
     pour compatibilité, ils restent transparents. */
  .zaq-builder__eau {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: transparent;
  }
  .zaq-builder__fond {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 0;
    z-index: 2;
    background: transparent;
  }
  .zaq-builder__fond-cap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 0;
    z-index: 3;
    background: transparent;
  }
  .zaq-builder__item {
    position: absolute;
    width: var(--zaq-item-size, 46px);
    height: var(--zaq-item-size, 46px);
    transform: translate(-50%, -50%);
    cursor: grab;
    touch-action: none;
    user-select: none;
    transition: width 0.2s ease, height 0.2s ease;
  }
  .zaq-builder__item:active { cursor: grabbing; }
  /* Wrapper séparé (plutôt que overflow:hidden sur .zaq-builder__item directement) :
     le bouton × est positionné hors de la boîte (-8px) et doit rester visible même
     si le visuel (photo cassée, alt trop long...) doit lui être découpé proprement. */
  .zaq-builder__item-visuel {
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 8px;
  }
  .zaq-builder__item-supprimer {
    position: absolute;
    top: -8px;
    right: -8px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 2px solid #fff;
    background: #b23b3b;
    color: #fff;
    font-size: 12px;
    line-height: 1;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .zaq-builder__astuce {
    margin: 0;
    font-size: 13px;
    color: #3d4a43;
    font-weight: 500;
    text-align: center;
  }
  .zaq-builder__capacite {
    margin: 0;
    font-size: 12.5px;
    font-weight: 600;
    color: #5b6b60;
    text-align: center;
  }
  .zaq-builder__capacite.zaq-builder__capacite--plein {
    color: #a3631f;
  }

  /* ---- Fantôme de glisser ---- */
  .zaq-builder__fantome {
    position: fixed;
    width: var(--zaq-item-size, 46px);
    height: var(--zaq-item-size, 46px);
    overflow: hidden;
    pointer-events: none;
    z-index: 1000;
    opacity: 0.9;
    filter: drop-shadow(0 4px 6px rgba(0, 0, 0, 0.25));
  }

  /* ---- Panier ---- */
  .zaq-builder__panier {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px;
    border: 2px solid #b7d4c1;
    border-radius: 10px;
    background: #eaf4ee;
  }
  .zaq-builder__panier-titre {
    margin: 0;
    font-size: 16px;
    font-weight: 800;
  }
  .zaq-builder__liste {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-height: 320px;
    overflow-y: auto;
  }
  .zaq-builder__liste li {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
  }
  .zaq-builder__liste-vide {
    color: #5b6b60;
    font-weight: 500 !important;
  }
  .zaq-builder__total {
    margin: 4px 0 0;
    padding-top: 8px;
    border-top: 1px solid #b7d4c1;
    font-size: 15px;
    font-weight: 700;
  }
  .zaq-builder__bouton {
    padding: 12px;
    border: none;
    border-radius: 8px;
    background: #2f6b48;
    color: #fff;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
  }
  .zaq-builder__bouton:disabled {
    background: #a9bcb0;
    cursor: not-allowed;
  }
  .zaq-builder__bouton-secondaire {
    padding: 8px;
    border: 2px solid #6f8a7a;
    border-radius: 8px;
    background: transparent;
    color: #3d4a43;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
  }
  .zaq-builder__confirmation {
    margin: 0;
    font-size: 12px;
    font-weight: 600;
    color: #1c4a30;
  }
</style>

<script>
(function () {
  // false = simulation (fonctionne partout, y compris hors Shopify).
  // true  = envoie reellement les articles au panier Shopify via
  //         /cart/add.js - necessite d'avoir renseigne variantId
  //         (l'ID de variante Shopify) pour chaque produit ci-dessous.
  // Cette version Liquid remplit deja variantId automatiquement (voir CATEGORIES
  // plus bas) : passer a true une fois teste sur une copie de theme.
  var MODE_SHOPIFY = false;

  function svgFeuille(c) {
    return '<svg viewBox="0 0 40 40" width="100%" height="100%"><path d="M20 4 C30 8 34 20 20 36 C6 20 10 8 20 4 Z" fill="' + c + '"/><line x1="20" y1="8" x2="20" y2="32" stroke="rgba(0,0,0,0.25)" stroke-width="1.5"/></svg>';
  }
  function svgRoche(c) {
    return '<svg viewBox="0 0 40 40" width="100%" height="100%"><path d="M4 30 Q2 18 14 14 Q18 4 28 10 Q38 12 36 24 Q38 34 26 36 Q12 40 4 30 Z" fill="' + c + '"/></svg>';
  }
  function svgCrevette(c) {
    return '<svg viewBox="0 0 40 24" width="100%" height="100%"><path d="M2 14 Q8 3 20 5 Q34 5 38 11 Q30 9 24 11 Q30 15 36 17 Q24 22 14 18 Q4 20 2 14 Z" fill="' + c + '"/></svg>';
  }
  function svgLampe(c) {
    return '<svg viewBox="0 0 40 24" width="100%" height="100%"><rect x="2" y="2" width="36" height="8" rx="3" fill="' + c + '"/><line x1="8" y1="14" x2="8" y2="22" stroke="' + c + '" stroke-width="2" opacity="0.5"/><line x1="20" y1="14" x2="20" y2="22" stroke="' + c + '" stroke-width="2" opacity="0.5"/><line x1="32" y1="14" x2="32" y2="22" stroke="' + c + '" stroke-width="2" opacity="0.5"/></svg>';
  }
  function svgThermometre(c) {
    return '<svg viewBox="0 0 20 40" width="100%" height="100%"><rect x="6" y="2" width="8" height="26" rx="4" fill="' + c + '"/><circle cx="10" cy="32" r="6" fill="' + c + '"/></svg>';
  }
  function svgFiltre(c) {
    return '<svg viewBox="0 0 40 40" width="100%" height="100%"><rect x="10" y="4" width="20" height="30" rx="6" fill="' + c + '"/><rect x="16" y="34" width="8" height="4" fill="' + c + '"/></svg>';
  }
  function svgBulle(c) {
    return '<svg viewBox="0 0 40 40" width="100%" height="100%"><circle cx="14" cy="26" r="8" fill="' + c + '" opacity="0.85"/><circle cx="26" cy="14" r="5" fill="' + c + '" opacity="0.6"/></svg>';
  }
  function svgOutil(c) {
    return '<svg viewBox="0 0 40 40" width="100%" height="100%"><rect x="17" y="4" width="6" height="24" rx="3" fill="' + c + '"/><circle cx="20" cy="32" r="7" fill="' + c + '" opacity="0.6"/></svg>';
  }
  function svgSable(c) {
    return '<svg viewBox="0 0 40 40" width="100%" height="100%"><rect x="2" y="14" width="36" height="20" rx="4" fill="' + c + '"/><circle cx="10" cy="24" r="1.6" fill="rgba(0,0,0,0.18)"/><circle cx="20" cy="20" r="1.6" fill="rgba(0,0,0,0.18)"/><circle cx="28" cy="26" r="1.6" fill="rgba(0,0,0,0.18)"/></svg>';
  }

  // Petit raccourci pour déclarer un produit : prixApprox=true => prix "≈", à vérifier
  // dans l'admin Shopify. "image" (optionnel, 5e argument) accepte une URL vers une
  // vraie photo produit — dès qu'elle est renseignée, elle remplace le pictogramme
  // SVG de la catégorie. Laisser vide tant qu'on n'a pas l'URL : le pictogramme
  // continue de s'afficher, rien d'autre ne casse.
  // tailleCm (6e argument, optionnel) : hauteur adulte réelle de la plante en
  // cm, utilisée pour la mettre à l'échelle du bac (voir calculerTailleItemPx).
  // Sans valeur, l'objet garde l'ancien calcul générique (proportionnel à la
  // largeur affichée du bac) - déco/matériel ne sont pas concernés ici.
  // variantId (7e argument, optionnel) : ID de variante Shopify réel, nécessaire
  // pour MODE_SHOPIFY = true (ajout panier réel). Rempli automatiquement ci-dessous
  // par les boucles Liquid, à partir de product.selected_or_first_available_variant.id.
  function pr(id, nom, prix, prixApprox, image, tailleCm, variantId) {
    return { id: id, nom: nom, prix: prix, prixApprox: !!prixApprox, variantId: variantId || null, image: image || null, tailleCm: tailleCm || null };
  }
  function echapperHtml(s) {
    return String(s).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
  }
  // Visuel effectif d'un produit : sa photo si renseignée, sinon le pictogramme
  // de secours de sa catégorie.
  function rendreVisuel(produit) {
    if (produit.image) {
      return '<img class="zaq-builder__img" src="' + echapperHtml(produit.image) + '" alt="' + echapperHtml(produit.nom) + '" loading="lazy">';
    }
    return ICONE_PAR_PRODUIT[produit.id] || '';
  }

  // Catalogue généré automatiquement à partir de vraies collections Shopify (Liquid) :
  // photo, prix réel et variantId sont récupérés directement depuis chaque produit,
  // plus besoin de les tenir à jour à la main comme dans le prototype statique.
  //
  // ⚠️ À ADAPTER avant mise en ligne :
  // - Le handle de collection entre crochets (ex. collections['plantes']) doit
  //   correspondre au vrai handle Shopify de la collection (Produits → Collections,
  //   visible dans l'URL). Les 8 noms ci-dessous sont des hypothèses, à corriger.
  // - metafields.custom.taille_cm (plantes) et metafields.custom.prix_approximatif
  //   sont optionnels : créer ces metafields produit dans l'admin Shopify si on
  //   veut garder cette info par produit, sinon laisser tel quel (0 / false partout).
  var CATEGORIES = [
    {
      id: 'plantes', nom: 'Plantes', icone: svgFeuille('#3f8f5f'),
      produits: [
        {% for product in collections['plantes'].products %}
        pr(
          {{ product.handle | json }},
          {{ product.title | json }},
          {{ product.price | divided_by: 100.0 }},
          {{ product.metafields.custom.prix_approximatif | default: false | json }},
          {{ product.featured_image | image_url: width: 400 | default: '' | json }},
          {{ product.metafields.custom.taille_cm | default: 0 }},
          {{ product.selected_or_first_available_variant.id | json }}
        ){% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    },
    {
      id: 'crevettes', nom: 'Crevettes & accessoires', icone: svgCrevette('#e0793c'),
      produits: [
        {% for product in collections['crevettes'].products %}
        pr(
          {{ product.handle | json }},
          {{ product.title | json }},
          {{ product.price | divided_by: 100.0 }},
          {{ product.metafields.custom.prix_approximatif | default: false | json }},
          {{ product.featured_image | image_url: width: 400 | default: '' | json }},
          0,
          {{ product.selected_or_first_available_variant.id | json }}
        ){% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    },
    {
      id: 'deco', nom: 'Décoration', icone: svgRoche('#8a7a63'),
      produits: [
        {% for product in collections['decoration'].products %}
        pr(
          {{ product.handle | json }},
          {{ product.title | json }},
          {{ product.price | divided_by: 100.0 }},
          {{ product.metafields.custom.prix_approximatif | default: false | json }},
          {{ product.featured_image | image_url: width: 400 | default: '' | json }},
          0,
          {{ product.selected_or_first_available_variant.id | json }}
        ){% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    },
    {
      id: 'eclairage', nom: 'Éclairage', icone: svgLampe('#c9a13a'),
      produits: [
        {% for product in collections['eclairage'].products %}
        pr(
          {{ product.handle | json }},
          {{ product.title | json }},
