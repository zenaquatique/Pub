# ── Groq (génération scripts — gratuit sur console.groq.com) ─────────────────
GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# ── Claude / Anthropic (optionnel — priorité sur Groq si renseigné) ───────────
ANTHROPIC_API_KEY=sk-ant-...

# ── ElevenLabs (voix off — optionnel) ────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ── OpenAI (optionnel) ────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Meta (Facebook + Instagram) ───────────────────────────────────────────────
# Token utilisateur avec permissions pages_manage_posts + pages_read_engagement
META_USER_TOKEN=EAALie...
META_PAGE_ID=687765537757887
META_APP_ID=
META_APP_SECRET=
META_IG_ACCOUNT_ID=17841470045036166

# Token de vérification webhook (choisi librement, à reporter dans Meta Dev Console)
META_WEBHOOK_VERIFY_TOKEN=mon_token_secret_webhook

# ── TikTok Content Posting API ────────────────────────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# ── Cloudinary — hébergement temporaire pour Instagram / TikTok ──────────────
# Compte gratuit sur cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Shopify (optionnel) ───────────────────────────────────────────────────────
SHOPIFY_SHOP_URL=ma-boutique.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_...

# ── SendGrid (emailing — optionnel) ──────────────────────────────────────────
SENDGRID_API_KEY=SG....
EMAIL_FROM=contact@ma-boutique.com
EMAIL_LIST_ID=

# ── Identité boutique ─────────────────────────────────────────────────────────
STORE_NAME=ZenAquatique
STORE_NICHE=plantes aquatiques cultivées en France
BRAND_VOICE=passionné, expert, accessible
TARGET_AUDIENCE=aquariophiles débutants et confirmés

# ── Planificateur ─────────────────────────────────────────────────────────────
POSTING_HOUR=9
POSTING_MINUTE=0
POSTING_TIMEZONE=Europe/Paris

# ── Ressources locales ────────────────────────────────────────────────────────
# PC principal (ec) — garder ces valeurs sur le PC principal
OBSIDIAN_VAULT_PATH=C:\Users\ec\Desktop\Obsidian\Pub
VIDEO_ASSETS_PATH=C:\Users\ec\Desktop\zenaquatique-video

# PC secondaire (sophi) — remplacer par ces valeurs sur le PC secondaire
# OBSIDIAN_VAULT_PATH=C:\Users\sophi\Desktop\Obsidian\Pub
# VIDEO_ASSETS_PATH=C:\Users\sophi\Desktop\zenaquatique-video
