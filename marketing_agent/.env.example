# ── Google Gemini ─────────────────────────────────────────────────────────────
GOOGLE_API_KEY=AIza...

# ── Boutique Shopify ─────────────────────────────────────────────────────────
# URL sans "https://" (ex: ma-boutique.myshopify.com)
SHOPIFY_SHOP_URL=ma-boutique.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_...

# ── Identité de la boutique ───────────────────────────────────────────────────
STORE_NAME=Ma Boutique
STORE_NICHE=mode féminine éco-responsable
BRAND_VOICE=dynamique, authentique, proche du client
TARGET_AUDIENCE=femmes 25-40 ans sensibles à l'environnement

# ── Meta (Instagram Business + Page Facebook) ─────────────────────────────────
META_ACCESS_TOKEN=EAA...
INSTAGRAM_BUSINESS_ID=17841400000000000
FACEBOOK_PAGE_ID=123456789012345
# Secret d'application pour vérifier les webhooks entrants
META_APP_SECRET=
# Token de vérification choisi librement (à renseigner aussi dans le tableau de bord Meta)
META_WEBHOOK_VERIFY_TOKEN=mon_token_secret_webhook

# ── TikTok ────────────────────────────────────────────────────────────────────
TIKTOK_ACCESS_TOKEN=

# ── SendGrid ──────────────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG....
# ID de l'expéditeur vérifié (Sender Identity) dans SendGrid
EMAIL_FROM=contact@ma-boutique.com
# ID de la liste de contacts SendGrid Marketing
EMAIL_LIST_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Planificateur ─────────────────────────────────────────────────────────────
# Heure et minute de la routine quotidienne (fuseau Europe/Paris)
POSTING_HOUR=9
POSTING_MINUTE=0
